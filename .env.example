# Copier vers .env (non versionné) ou définir dans l'hébergeur.
NODE_ENV=production
PORT=3000
# Fichier SQLite (monter un volume persistant en production)
DATABASE_PATH=./data/capatransport.db
# Création du 1er administrateur au démarrage (12 caractères minimum) — puis retirer ADMIN_PASSWORD
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Derrière un reverse proxy : nombre de proxys de confiance (pour lire la vraie IP)
TRUST_PROXY=1
# Durée d'une session admin (heures)
ADMIN_SESSION_HOURS=12
# Transport d'email du rapport (voir docs/ARCHITECTURE.md) — « disabled » par défaut
REPORT_TRANSPORT=disabled
